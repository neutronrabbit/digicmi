 "device": "digitakt-mk1",
 "os": "1.53",
 "description": "Adds a CMI machine (FUNC+SRC list), machine 40: Digi Poly 2.1's polyphony on ONESHOT. The track plays one one-shot sample polyphonically, pitched from MIDI note 60, borrowing other tracks' voices (SETTINGS > POLY picks which); notes on the track's MIDI channel play one voice each. Velocity sets each voice's volume (the stock gain, (vel/127)^2). Voice stealing takes the quietest voice. Conflicts with Digi Poly (same sites).",
 "sources": [
  "poly_ui.s",
  "poly_glue.s",
  "poly.c"
 ],
